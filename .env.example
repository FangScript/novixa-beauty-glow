# Runtime
APP_URL=http://localhost:8080
NODE_ENV=development

# Optional first administrator bootstrap (used by `bun run db:seed`)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-long-random-password

# PostgreSQL / Prisma
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/novixa?schema=public
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/novixa?schema=public

# Authentication
# Generate at least 32 random characters; used for OAuth state and checkout capabilities.
AUTH_SECRET=replace-with-a-long-random-secret-of-at-least-32-characters
AUTH_URL=http://localhost:8080

# Google OAuth (create credentials at console.cloud.google.com)
# Authorized redirect URI: ${APP_URL}/api/auth/customer/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google Search Console Verification Token (Optional, defaults to googlee0fc743357390d7b)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=


# Payments (Provider-agnostic Architecture)
# Online checkout currently enables PayPal-hosted card, PayPal, Google Pay, and Apple Pay.
PAYMENT_PROVIDER=PAYPAL
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
# Set PAYPAL_MODE to "live" for production, or "sandbox" for testing
PAYPAL_MODE=live
NEXT_PUBLIC_PAYPAL_MODE=live
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
# Google Pay reads validated runtime settings from /api/payments/config.
# Other client components embed NEXT_PUBLIC values at BUILD time; rebuild after changes.
# Use Google PRODUCTION + PayPal live, or Google TEST + PayPal sandbox.
# The client ID must belong to the same account/application as PAYPAL_CLIENT_ID.
# Google Pay: Set to "PRODUCTION" when approved in Google Pay Console, or "TEST" for evaluation
NEXT_PUBLIC_GOOGLE_PAY_ENV=PRODUCTION
NEXT_PUBLIC_GOOGLE_PAY_MERCHANT_ID=
# Optional server-only runtime alternatives; when unset, use the public values above.
# GOOGLE_PAY_ENV=PRODUCTION
# GOOGLE_PAY_MERCHANT_ID=
# Merchant ID is a fallback only: PayPal SDK merchantInfo takes precedence.
# Never substitute the PayPal seller ID for a Google merchant ID.
# Apple Pay (optional custom certs for direct Apple Merchant session validation)
APPLE_PAY_MERCHANT_IDENTIFIER=merchant.com.novixaretail
APPLE_PAY_CERTIFICATE=
APPLE_PAY_PRIVATE_KEY=
BANK_ACCOUNT_NAME=
BANK_SORT_CODE=
BANK_ACCOUNT_NUMBER=
BANK_IBAN=

# Transactional email (Gmail SMTP / Resend)
EMAIL_PROVIDER=GMAIL
EMAIL_FROM="NOVIXA <novixaretail@gmail.com>"
SUPPORT_EMAIL=novixaretail@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=novixaretail@gmail.com
SMTP_PASS=
# Resend alternative:
RESEND_API_KEY=
EMAIL_API_KEY=

# Media storage (leave unset until a provider is selected)
MEDIA_BUCKET=
MEDIA_PUBLIC_BASE_URL=
