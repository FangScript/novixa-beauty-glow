# Runtime
APP_URL=http://localhost:8080
NODE_ENV=development

# Optional first administrator bootstrap (used by `bun run db:seed`)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-long-random-password

# PostgreSQL / Prisma
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/novixa?schema=public
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/novixa?schema=public

# Authentication
AUTH_SECRET=replace-with-a-long-random-secret
AUTH_URL=http://localhost:8080

# Google OAuth (create credentials at console.cloud.google.com)
# Authorized redirect URI: ${APP_URL}/api/auth/customer/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=


# Payments (Provider-agnostic Architecture)
# Supported Providers: LOCAL_GATEWAY, PAYPAL, BANK_TRANSFER, COD
PAYMENT_PROVIDER=LOCAL_GATEWAY
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
BANK_ACCOUNT_NAME=
BANK_SORT_CODE=
BANK_ACCOUNT_NUMBER=
BANK_IBAN=

# Transactional email (leave unset until a provider is selected)
EMAIL_FROM=hello@novixa.co
EMAIL_PROVIDER=
EMAIL_API_KEY=

# Media storage (leave unset until a provider is selected)
MEDIA_BUCKET=
MEDIA_PUBLIC_BASE_URL=
