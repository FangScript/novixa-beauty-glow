# Runtime
APP_URL=http://localhost:8080
NODE_ENV=development

# Optional first administrator bootstrap (used by `bun run db:seed`)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-long-random-password

# PostgreSQL / Prisma
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/novixa?schema=public
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/novixa?schema=public

# Authentication
AUTH_SECRET=replace-with-a-long-random-secret
AUTH_URL=http://localhost:8080

# Google OAuth (create credentials at console.cloud.google.com)
# Authorized redirect URI: ${APP_URL}/api/auth/customer/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=


# Payments (Provider-agnostic Architecture)
# Supported Providers: LOCAL_GATEWAY, PAYPAL, BANK_TRANSFER, COD
PAYMENT_PROVIDER=PAYPAL
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Set PAYPAL_MODE to "live" for production, or "sandbox" for testing
PAYPAL_MODE=live
NEXT_PUBLIC_PAYPAL_MODE=live
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
# Google Pay: Set to "PRODUCTION" when approved in Google Pay Console, or "TEST" for evaluation
NEXT_PUBLIC_GOOGLE_PAY_ENV=PRODUCTION
NEXT_PUBLIC_GOOGLE_PAY_MERCHANT_ID=
# Apple Pay (optional custom certs for direct Apple Merchant session validation)
APPLE_PAY_MERCHANT_IDENTIFIER=merchant.com.novixaretail
APPLE_PAY_CERTIFICATE=
APPLE_PAY_PRIVATE_KEY=
BANK_ACCOUNT_NAME=
BANK_SORT_CODE=
BANK_ACCOUNT_NUMBER=
BANK_IBAN=

# Transactional email (Gmail SMTP / Resend)
EMAIL_PROVIDER=GMAIL
EMAIL_FROM="NOVIXA <novixaretail@gmail.com>"
SUPPORT_EMAIL=novixaretail@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=novixaretail@gmail.com
SMTP_PASS=
# Resend alternative:
RESEND_API_KEY=
EMAIL_API_KEY=

# Media storage (leave unset until a provider is selected)
MEDIA_BUCKET=
MEDIA_PUBLIC_BASE_URL=
